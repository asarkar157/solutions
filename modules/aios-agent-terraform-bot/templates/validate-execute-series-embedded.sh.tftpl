/bin/bash <<'TFBOT_VALIDATE_EXECUTE'
set -euo pipefail
export HOME=${ubuntu_integration_home}
export PATH="${ubuntu_integration_home}/.local/bin:/usr/local/bin:/usr/bin:/bin"
export GIT_TERMINAL_PROMPT=0
export TFBOT_EMBEDDED=1
WORK_ROOT="{{work_root}}"
MODULE_PATH="$${MODULE_PATH:-}"
REPO_FULL_NAME="$${REPO_FULL_NAME:-}"
ISSUE_OR_PR="$${ISSUE_OR_PR:-}"
BASE_BRANCH="$${BASE_BRANCH:-main}"

parse_trigger_json() {
  local raw="$${TRIGGER_JSON:-}"
  [ -n "$raw" ] || return 1
  if [ -z "$REPO_FULL_NAME" ]; then
    REPO_FULL_NAME="$(printf '%s' "$raw" | jq -r '.repository.full_name // empty')"
  fi
  if [ -z "$ISSUE_OR_PR" ]; then
    ISSUE_OR_PR="$(printf '%s' "$raw" | jq -r '.issue.number // .pull_request.number // empty')"
  fi
  if [ "$BASE_BRANCH" = "main" ]; then
    BASE_BRANCH="$(printf '%s' "$raw" | jq -r '.repository.default_branch // "main"')"
  fi
}

if [ -z "$MODULE_PATH" ]; then
  echo "error=missing_MODULE_PATH"
  exit 1
fi
if [ ! -d "$MODULE_PATH" ]; then
  echo "validation_error=module_path_missing path=$MODULE_PATH"
  exit 1
fi
parse_trigger_json || true

validate_out="$WORK_ROOT/.work/validate.out"
mkdir -p "$WORK_ROOT/.work"
/bin/bash -s validate "$WORK_ROOT" "$MODULE_PATH" <<'TFBOT_STAGE_RUNNER' | tee "$validate_out"
export TFBOT_EMBEDDED=1
${stage_runner_script}
TFBOT_STAGE_RUNNER

if ! grep -qE '^fmt_exit=' "$validate_out"; then
  echo "validation_error=missing_fmt_exit_marker"
  echo "module_quality_summary=BLOCKED"
  exit 1
fi

if ! grep -qE '^module_quality_summary=PASS' "$validate_out"; then
  echo "module_quality_rework=true"
  exit 0
fi

if [ -z "$REPO_FULL_NAME" ] || [ -z "$ISSUE_OR_PR" ]; then
  echo "push_skipped=missing_repo_or_issue"
  echo "script_pack_version=${script_pack_version}"
  exit 0
fi

commit_out="$WORK_ROOT/.work/commit-pr.out"
/bin/bash -s commit-pr "$WORK_ROOT" "$REPO_FULL_NAME" "$ISSUE_OR_PR" "" "$BASE_BRANCH" <<'TFBOT_STAGE_RUNNER' | tee "$commit_out" || true
export TFBOT_EMBEDDED=1
${stage_runner_script}
TFBOT_STAGE_RUNNER

grep -E '^(pr_url|working_branch|pr_title|pr_blocker|pr_error|pr_prepushed)=' "$commit_out" || true
echo "script_pack_version=${script_pack_version}"
TFBOT_VALIDATE_EXECUTE
