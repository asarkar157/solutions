set -euo pipefail
export HOME=${ubuntu_integration_home}
export PATH="${ubuntu_integration_home}/.local/bin:/usr/local/bin:/usr/bin:/bin"
export GIT_TERMINAL_PROMPT=0
WORK_ROOT="{{work_root}}"
MODULE_PATH="$${MODULE_PATH:-}"
if [ -z "$MODULE_PATH" ]; then
  echo "error=missing_MODULE_PATH"
  exit 1
fi
if [ ! -d "$MODULE_PATH" ]; then
  echo "validation_error=module_path_missing path=$MODULE_PATH"
  exit 1
fi

find_tf() {
  local c
  for c in tofu terraform; do
    if command -v "$c" >/dev/null 2>&1; then
      command -v "$c"
      return 0
    fi
  done
  return 1
}

tf=""
for _wait in $(seq 1 20); do
  if tf="$(find_tf)"; then
    break
  fi
  sleep 3
done
if [ -z "$tf" ]; then
  echo "validation_error=no_iac_binary"
  exit 1
fi

work_dir="$WORK_ROOT/.work"
mkdir -p "$work_dir"
cd "$MODULE_PATH"

tf_version="$("$tf" version | head -1)"
fmt_rc=0 init_rc=0 valid_rc=0 test_rc=0
"$tf" fmt -recursive >"$work_dir/tf-fmt-apply.out" 2>&1 || true
"$tf" fmt -recursive -check >"$work_dir/tf-fmt.out" 2>&1 || fmt_rc=$?
"$tf" init -backend=false -input=false -upgrade >"$work_dir/tf-init.out" 2>&1 || init_rc=$?
"$tf" validate -no-color >"$work_dir/tf-validate.out" 2>&1 || valid_rc=$?
if compgen -G "*.tftest.hcl" >/dev/null || [ -d tests ]; then
  "$tf" test -verbose >"$work_dir/tf-test.out" 2>&1 || test_rc=$?
else
  echo "test_skipped=no_tftest_files" >"$work_dir/tf-test.out"
fi

summary="binary=$${tf_version}; fmt=$([ "$fmt_rc" -eq 0 ] && echo PASS || echo FAIL); init=$([ "$init_rc" -eq 0 ] && echo PASS || echo FAIL); validate=$([ "$valid_rc" -eq 0 ] && echo PASS || echo FAIL); test=$([ "$test_rc" -eq 0 ] && echo PASS || echo FAIL)"
if [ "$fmt_rc" -eq 0 ] && [ "$valid_rc" -eq 0 ] && [ "$test_rc" -eq 0 ]; then
  mq="PASS"
else
  mq="NEEDS_REVISION"
fi

echo "fmt_exit=$${fmt_rc}"
echo "init_exit=$${init_rc}"
echo "validate_exit=$${valid_rc}"
echo "test_exit=$${test_rc}"
echo "$summary"
echo "module_quality_summary=$mq"

if [ "$mq" = "PASS" ]; then
  REPO_FULL_NAME="$${REPO_FULL_NAME:-}"
  ISSUE_OR_PR="$${ISSUE_OR_PR:-}"
  BASE_BRANCH="$${BASE_BRANCH:-main}"
  if [ -z "$REPO_FULL_NAME" ] || [ -z "$ISSUE_OR_PR" ]; then
    raw="$${TRIGGER_JSON:-}"
    if [ -n "$raw" ]; then
      [ -z "$REPO_FULL_NAME" ] && REPO_FULL_NAME="$(printf '%s' "$raw" | jq -r '.repository.full_name // empty')"
      [ -z "$ISSUE_OR_PR" ] && ISSUE_OR_PR="$(printf '%s' "$raw" | jq -r '.issue.number // .pull_request.number // empty')"
      BASE_BRANCH="$(printf '%s' "$raw" | jq -r '.repository.default_branch // "main"')"
    fi
  fi
  if [ -n "$REPO_FULL_NAME" ] && [ -n "$ISSUE_OR_PR" ]; then
    git_token="$${GIT_TOKEN:-$${GITHUB_TOKEN:-$${GH_TOKEN:-}}}"
    if [ -n "$git_token" ]; then
      export GIT_TOKEN="$git_token" GH_TOKEN="$git_token" GITHUB_TOKEN="$git_token"
      gh auth setup-git 2>/dev/null || true
      git config --global user.name "stackgen-terraform-bot"
      git config --global user.email "terraform-bot@stackgen.local"
      repo_dir="$WORK_ROOT/repo"
      if [ -d "$repo_dir/.git" ] || [ -e "$repo_dir/.git" ]; then
        cd "$repo_dir"
        git add -A
        if ! git diff --cached --quiet; then
          module_relpath="$${MODULE_PATH#"$repo_dir"/}"
          module_relpath="$${module_relpath#/}"
          provider="$${module_relpath%%/*}"
          module_name="$(basename "$module_relpath")"
          module_slug="$${module_name//_/-}"
          branch="terraform-bot/$${provider}-$${module_slug}-$$(date +%Y%m%d%H%M%S)"
          pr_title="feat($${provider}): add $${module_name} module"
          git switch -c "$branch" 2>/dev/null || git switch "$branch"
          git commit -m "$${pr_title}

Closes $${REPO_FULL_NAME}#$${ISSUE_OR_PR}" || true
          if git push -u origin HEAD 2>"$work_dir/push.err"; then
            echo "working_branch=$branch"
            echo "pr_prepushed=true"
            echo "pr_title=$pr_title"
          else
            echo "pr_blocker=push_failed"
            cat "$work_dir/push.err" >&2 || true
          fi
        fi
      fi
    else
      echo "push_skipped=no_token"
    fi
  fi
fi
