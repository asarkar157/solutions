/bin/bash <<'TFBOT_VALIDATE_EXECUTE'
set -euo pipefail
export HOME=${ubuntu_integration_home}
export PATH="${ubuntu_integration_home}/.local/bin:/usr/local/bin:/usr/bin:/bin"
export GIT_TERMINAL_PROMPT=0
export TFBOT_EMBEDDED=1
export TFBOT_ALLOW_DIRECT=1
: "$${WORK_ROOT:?export WORK_ROOT before validate one-liner}"
export DEFER_PR_UNTIL_PASS="${defer_pr_until_quality_pass}"
export MODULE_PATH="$${MODULE_PATH:-}"
export REPO_FULL_NAME="$${REPO_FULL_NAME:-}"
export ISSUE_OR_PR="$${ISSUE_OR_PR:-}"
export BASE_BRANCH="$${BASE_BRANCH:-main}"
STAGE_RUNNER="$WORK_ROOT/.pack/stage-runner.sh"

materialize_stage_runner() {
  mkdir -p "$WORK_ROOT/.pack"
  printf '%s' "${script_pack_runner_b64}" | base64 -d > "$STAGE_RUNNER"
  chmod +x "$STAGE_RUNNER"
  local runner_actual
  runner_actual="$(sha256sum "$STAGE_RUNNER" | awk '{print $1}')"
  if [ "$runner_actual" != "${script_pack_runner_sha256}" ]; then
    echo "script_pack_error=runner_sha256_mismatch expected=${script_pack_runner_sha256} actual=$runner_actual"
    exit 1
  fi
  echo "stage_runner_sha256=$runner_actual"
}

parse_trigger_json() {
  local raw="$${TRIGGER_JSON:-}"
  [ -n "$raw" ] || return 1
  if [ -z "$REPO_FULL_NAME" ]; then
    REPO_FULL_NAME="$(printf '%s' "$raw" | jq -r '.repository.full_name // empty')"
    export REPO_FULL_NAME
  fi
  if [ -z "$ISSUE_OR_PR" ]; then
    ISSUE_OR_PR="$(printf '%s' "$raw" | jq -r '.issue.number // .pull_request.number // empty')"
    export ISSUE_OR_PR
  fi
  if [ "$BASE_BRANCH" = "main" ]; then
    BASE_BRANCH="$(printf '%s' "$raw" | jq -r '.repository.default_branch // "main"')"
    export BASE_BRANCH
  fi
}

if [ -z "$MODULE_PATH" ]; then
  echo "error=missing_MODULE_PATH"
  exit 1
fi
if [ ! -d "$MODULE_PATH" ]; then
  echo "validation_error=module_path_missing path=$MODULE_PATH"
  exit 1
fi

materialize_stage_runner
parse_trigger_json || true

if ! command -v tofu >/dev/null 2>&1 && ! command -v terraform >/dev/null 2>&1; then
  echo "validation_error=no_iac_binary"
  echo "fmt_exit=1"
  echo "module_quality_summary=BLOCKED"
  exit 1
fi

set +e
/bin/bash -s validate-and-pr "$WORK_ROOT" "$MODULE_PATH" < "$STAGE_RUNNER"
validate_rc=$?
set -e
exit "$validate_rc"
TFBOT_VALIDATE_EXECUTE
