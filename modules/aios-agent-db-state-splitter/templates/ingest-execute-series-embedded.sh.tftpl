set -euo pipefail
export HOME=${runner_work_home}
export WORKFLOW_RUN_ID="{{workflow_run_id}}"

# Plain bash ingest bootstrap. Decoded from DBSPLIT_INGEST_BOOTSTRAP_B64 in runner script-pack secret at runtime (see spawn_contracts INGEST_BOOTSTRAP_EXECUTE_COMMAND).
# Script pack bytes live in the same secret JSON (DBSPLIT_SCRIPT_PACK_*), synced at tofu apply — not inlined in spawn context.
dbsplit_resolve_work_root() {
  if [ -n "$${WORKFLOW_RUN_ID:-}" ]; then
    ABS_WORK_ROOT="${runner_work_home}/.$${WORKFLOW_RUN_ID}"
    WORK_ROOT="$ABS_WORK_ROOT"
    echo "WORK_ROOT_source=WORKFLOW_RUN_ID path=$WORK_ROOT"
    return 0
  fi
  local uri_file=""
  uri_file="$(find ${runner_work_home} -maxdepth 4 -path '*/.work/spawn_monolith_uri' -print -quit 2>/dev/null || true)"
  if [ -n "$uri_file" ] && [ -f "$uri_file" ]; then
    ABS_WORK_ROOT="$(cd "$(dirname "$(dirname "$uri_file")")" && pwd)"
    WORK_ROOT="$ABS_WORK_ROOT"
    echo "WORK_ROOT_source=spawn_monolith_uri_file path=$WORK_ROOT"
    return 0
  fi
  return 1
}

if ! dbsplit_resolve_work_root; then
  echo "error=WORK_ROOT_unset"
  exit 1
fi

dbsplit_resolve_monolith_uri() {
  local work_root="$${1:?WORK_ROOT}"
  if [ -n "$${MONOLITH_URI:-}" ]; then
    return 0
  fi
  if [ -n "$${MONOLITH_STATE_URI:-}" ]; then
    export MONOLITH_URI="$${MONOLITH_STATE_URI}"
    echo "MONOLITH_URI_source=MONOLITH_STATE_URI"
    return 0
  fi
  if [ -n "$${TFSTATE_FILE:-}" ]; then
    export MONOLITH_URI="$${TFSTATE_FILE}"
    echo "MONOLITH_URI_source=TFSTATE_FILE"
    return 0
  fi
  mkdir -p "$work_root/.work"
  if [ -f "$work_root/.work/spawn_monolith_uri" ]; then
    export MONOLITH_URI="$(tr -d '\n\r' < "$work_root/.work/spawn_monolith_uri")"
    echo "MONOLITH_URI_source=spawn_monolith_uri_file"
    return 0
  fi
  if [ -f "$work_root/notes.json" ]; then
    local raw
    raw="$(jq -r '.monolith_state_uri // .tfstate_file // empty' "$work_root/notes.json" 2>/dev/null || true)"
    raw="$${raw#monolith_state_uri=}"
    if [ -n "$raw" ]; then
      export MONOLITH_URI="$raw"
      echo "MONOLITH_URI_source=notes_json_fallback"
      return 0
    fi
  fi
  return 1
}

${dbsplit_script_pack_env_helpers}

mkdir -p "$WORK_ROOT/scripts" "$WORK_ROOT/state" "$WORK_ROOT/.work"
[ -f "$WORK_ROOT/notes.json" ] || echo '{}' >"$WORK_ROOT/notes.json"
chmod 700 "$WORK_ROOT" 2>/dev/null || true

if ! dbsplit_resolve_monolith_uri "$WORK_ROOT"; then
  echo "error=MONOLITH_URI_unset"
  exit 1
fi
echo "MONOLITH_URI_resolved=true"

if ! dbsplit_ensure_script_pack "$WORK_ROOT"; then
  exit 1
fi
export DBSPLIT_EMBEDDED=1
export DBSPLIT_ALLOCATE_SHA256="${script_pack_allocate_sha256}"
export DBSPLIT_DEFAULT_STRATEGY="${default_grouping_strategy}"
export DBSPLIT_DEFAULT_CAP="${default_max_resources_per_appstack}"
export DBSPLIT_STACKGEN_PROJECT_NAME="${stackgen_project_name_default}"
bash -s ingest-and-split "$WORK_ROOT" "$MONOLITH_URI" < "$WORK_ROOT/scripts/stage-runner.sh"
