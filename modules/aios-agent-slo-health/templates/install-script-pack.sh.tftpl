#!/usr/bin/env bash
set -euo pipefail
PACK_DIR="${slo_health_pack_dir}"
mkdir -p "$${PACK_DIR}"
echo "${script_pack_tarball_b64}" | base64 -d | tar -xzf - -C "$${PACK_DIR}"
chmod +x "$${PACK_DIR}/stage-runner.sh" "$${PACK_DIR}/commit-openslo-pr.sh"
EXPECTED_RUNNER="${script_pack_stage_runner_sha256}"
ACTUAL_RUNNER="$$(sha256sum "$${PACK_DIR}/stage-runner.sh" | awk '{print $$1}')"
if [[ "$${ACTUAL_RUNNER}" != "$${EXPECTED_RUNNER}" ]]; then
  echo "script_pack_error=runner_sha256_mismatch"
  exit 1
fi
echo "script_pack_installed=true script_pack_version=${script_pack_version}"
