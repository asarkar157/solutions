PD='${cdkbot_pack_dir}'; mkdir -p "$PD" "$PD/.work"; cdkbot_load_script_pack_env() { json="$${CDKBOT_SCRIPT_PACK_ENV_JSON:-$${value:-}}"; if [ -z "$${CDKBOT_SCRIPT_PACK_TARBALL_B64:-}" ] && [ -n "$json" ]; then CDKBOT_SCRIPT_PACK_VERSION="$(printf '%s' "$json" | jq -r '.CDKBOT_SCRIPT_PACK_VERSION // empty')"; CDKBOT_SCRIPT_PACK_TARBALL_B64="$(printf '%s' "$json" | jq -r '.CDKBOT_SCRIPT_PACK_TARBALL_B64 // empty')"; export CDKBOT_SCRIPT_PACK_VERSION CDKBOT_SCRIPT_PACK_TARBALL_B64; fi; if [ -z "$${CDKBOT_SCRIPT_PACK_TARBALL_B64:-}" ]; then return 1; fi; return 0; }; cdkbot_pack_installed() { [ -f "$PD/.script_pack_version" ] && [ "$(cat "$PD/.script_pack_version")" = "${script_pack_version}" ] && [ -x "$PD/stage-runner.sh" ] && [ -x "$PD/clone-pack.sh" ] && [ "$(sha256sum "$PD/stage-runner.sh" | awk '{print $1}')" = "${script_pack_runner_sha256}" ] && [ "$(sha256sum "$PD/clone-pack.sh" | awk '{print $1}')" = "${script_pack_clone_sha256}" ]; }; cdkbot_materialize_script_pack() { tmp="$PD/.work/script-pack-staging"; rm -rf "$tmp"; mkdir -p "$tmp"; if ! printf %s "$${CDKBOT_SCRIPT_PACK_TARBALL_B64}" | tr -d '[:space:]' | base64 -d | tar -xzf - -C "$tmp" 2>"$PD/.work/script-pack-extract.err"; then echo cdkbot_pack_error=tarball_extract_failed; cat "$PD/.work/script-pack-extract.err" 2>/dev/null || true; return 1; fi; rm -rf "$PD"/*; mkdir -p "$PD"; cp -a "$tmp"/. "$PD"/; chmod +x "$PD/"*.sh 2>/dev/null || true; printf '%s\n' "${script_pack_version}" >"$PD/.script_pack_version"; echo script_pack_install=embedded_tarball version=${script_pack_version}; return 0; }; if cdkbot_pack_installed; then :; elif cdkbot_load_script_pack_env && cdkbot_materialize_script_pack; then :; elif [ -x "$PD/clone-pack.sh" ] && [ -x "$PD/stage-runner.sh" ]; then :; else echo cdkbot_pack_error=missing_pack hint=${pack_missing_hint}; exit 1; fi
