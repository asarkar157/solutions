package stage_gate

import rego.v1

default allow = false

_text := lower(input.stage_input)

allow if {
  severity_ok
  service_ok
  environment_ok
  not is_blocked_service
}

severity_ok if { not ${severities_gate_enabled} }
severity_ok if {
  some s in [${severities_rego_literals}]
  regex.match(sprintf(`\b%s\b`, [s]), _text)
}

service_ok if { not ${services_gate_enabled} }
service_ok if {
  some s in [${services_rego_literals}]
  contains(_text, s)
}

environment_ok if { not ${environments_gate_enabled} }
environment_ok if {
  some e in [${environments_rego_literals}]
  contains(_text, e)
}

is_blocked_service if {
  ${blocked_gate_enabled}
  some b in [${blocked_services_rego_literals}]
  contains(_text, b)
}

deny contains msg if {
  not severity_ok
  msg := "Incident severity not in allowed ingest list"
}

deny contains msg if {
  not service_ok
  msg := "Incident service not in allowed ingest list"
}

deny contains msg if {
  not environment_ok
  msg := "Incident environment not in allowed ingest list"
}

deny contains msg if {
  is_blocked_service
  msg := "Incident service matches blocked ingest rule"
}
