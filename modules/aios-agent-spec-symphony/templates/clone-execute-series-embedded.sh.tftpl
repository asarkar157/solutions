/bin/bash <<'SPECSYM_CLONE_EXECUTE'
HOME=${shell_work_home}
GIT_TERMINAL_PROMPT=0
: "$${WORK_ROOT:?set WORK_ROOT before clone one-liner}"

normalize_work_root() {
  local wr="$${1:-}"
  local runner_home="${shell_work_home}"
  local home_token='${home_brace_literal}'
  if [[ "$$wr" == *"\$HOME"* ]]; then
    wr="$${wr//\$HOME/$$runner_home}"
  fi
  if [[ "$$wr" == *"$$home_token"* ]]; then
    wr="$${wr//$$home_token/$$runner_home}"
  fi
  printf '%s' "$$wr"
}

validate_work_root() {
  local wr="$${1:-}"
  local runner_home="${shell_work_home}"
  local home_token='${home_brace_literal}'
  if [[ "$$wr" == *"\$HOME"* ]]; then
    wr="$${wr//\$HOME/$$runner_home}"
  fi
  if [[ "$$wr" == *"$$home_token"* ]]; then
    wr="$${wr//$$home_token/$$runner_home}"
  fi
  case "$$wr" in
    *'{'*|*'}'*|*'$'*|*" "*)
      echo "clone_blocker=malformed_work_root"
      echo "error=malformed_work_root reason=illegal_chars"
      return 1
      ;;
  esac
  [[ "$$wr" =~ ^/ ]] || { echo "clone_blocker=malformed_work_root"; return 1; }
  [[ "$$wr" =~ //[a-zA-Z] ]] && { echo "clone_blocker=malformed_work_root"; return 1; }
  return 0
}

WORK_ROOT="$$(normalize_work_root "$${WORK_ROOT}")"
export WORK_ROOT
validate_work_root "$${WORK_ROOT}" || exit 1
mkdir -p "$${WORK_ROOT}"

is_placeholder_clone_url() {
  case "$${1:-}" in
    ""|*example.com/example*|*github.com/example/*|*github.com/example.git*) return 0 ;;
  esac
  return 1
}

git_clone_url() {
  local url="$${1:-}"
  local tok="$${2:-}"
  if [[ "$$url" =~ ^https://[^/@]+@ ]]; then
    printf '%s' "$$url"
    return 0
  fi
  if [ -n "$$tok" ] && [[ "$$url" =~ ^https://github\.com/ ]]; then
    printf 'https://x-access-token:%s@github.com/%s' "$$tok" "$${url#https://github.com/}"
    return 0
  fi
  printf '%s' "$$url"
}

parse_trigger_json() {
  local raw="$${TRIGGER_JSON:-}"
  [ -n "$$raw" ] || return 1
  REPO_CLONE_URL="$$(printf '%s' "$$raw" | jq -r 'if (.repository.clone_url // "") != "" then .repository.clone_url else "https://github.com/" + .repository.full_name + ".git" end')"
  DEFAULT_BRANCH="$$(printf '%s' "$$raw" | jq -r '.repository.default_branch // "main"')"
  ISSUE_OR_PR="$$(printf '%s' "$$raw" | jq -r '.issue.number // .pull_request.number // empty')"
}

hydrate_clone_params() {
  if [ -n "$${TRIGGER_JSON_B64:-}" ]; then
    TRIGGER_JSON="$$(printf '%s' "$$TRIGGER_JSON_B64" | base64 -d)"
    export TRIGGER_JSON
  fi
  if [ -z "$${REPO_CLONE_URL:-}" ] || [ -z "$${DEFAULT_BRANCH:-}" ] || [ -z "$${ISSUE_OR_PR:-}" ]; then
    parse_trigger_json || true
  fi
}

if is_placeholder_clone_url "$${REPO_CLONE_URL:-}"; then
  unset REPO_CLONE_URL DEFAULT_BRANCH ISSUE_OR_PR
fi
hydrate_clone_params || true

if [ -z "$${REPO_CLONE_URL:-}" ] || [ -z "$${DEFAULT_BRANCH:-}" ]; then
  echo "clone_blocker=missing_clone_params"
  exit 1
fi
if is_placeholder_clone_url "$${REPO_CLONE_URL}"; then
  echo "clone_blocker=placeholder_url"
  exit 1
fi

git_token="$${GIT_TOKEN:-$${GITHUB_TOKEN:-$${GH_TOKEN:-}}}"
if [ -n "$$git_token" ]; then
  export GIT_TOKEN="$$git_token" GH_TOKEN="$$git_token" GITHUB_TOKEN="$$git_token"
  gh auth setup-git 2>/dev/null || true
  git config --global user.name "stackgen-spec-symphony"
  git config --global user.email "spec-symphony@stackgen.local"
  echo "gh_env_present=true"
else
  echo "gh_env_present=false"
fi

effective_url="$$(git_clone_url "$${REPO_CLONE_URL}" "$$git_token")"
repo_dir="$${WORK_ROOT}/repo"
if [[ "$$repo_dir" =~ [{}] ]] || [[ "$$repo_dir" != */repo ]]; then
  echo "clone_blocker=malformed_work_root"
  exit 1
fi

if [ ! -d "$$repo_dir/.git" ]; then
  git clone "$$effective_url" "$$repo_dir" 2>"$${WORK_ROOT}/clone.err" || {
    echo "clone_blocker=auth_or_network"
    cat "$${WORK_ROOT}/clone.err" >&2 || true
    exit 1
  }
else
  git -C "$$repo_dir" fetch --all --prune
fi

if [ -n "$${ISSUE_OR_PR:-}" ] && [[ "$${ISSUE_OR_PR}" =~ ^[0-9]+$$ ]]; then
  git -C "$$repo_dir" fetch origin "pull/$${ISSUE_OR_PR}/head:pr-$${ISSUE_OR_PR}" 2>/dev/null \
    && git -C "$$repo_dir" switch "pr-$${ISSUE_OR_PR}" 2>/dev/null \
    || git -C "$$repo_dir" switch "$${DEFAULT_BRANCH}" 2>/dev/null || true
else
  git -C "$$repo_dir" switch "$${DEFAULT_BRANCH}" 2>/dev/null \
    || git -C "$$repo_dir" switch -c "$${DEFAULT_BRANCH}" "origin/$${DEFAULT_BRANCH}" 2>/dev/null || true
fi

sha="$$(git -C "$$repo_dir" rev-parse HEAD)"
echo "repo_clone_path=$$repo_dir"
echo "repo_head_sha=$$sha"
echo "script_pack_version=${script_pack_version}"
echo "stage_summary:intake-clone-bootstrap=done"
SPECSYM_CLONE_EXECUTE
