# =============================================================================
# Complete AIOS stack — example tfvars
# =============================================================================
# Copy this file to terraform.tfvars and fill in real values, or set the same
# variables via TF_VAR_* environment variables (preferred for tokens).
#
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars
#   tofu init && tofu plan && tofu apply
#
# This root is validated in CI via `make validate`. See README.md for layer
# diagram and optional integrations.

# ----- StackGen / Guild -------------------------------------------------------
stackgen_url        = "https://main.dev.stackgen.com"
stackgen_token      = "sg_pat_replace_me"       # sensitive — prefer TF_VAR_stackgen_token
stackgen_project_id = ""                         # leave empty unless your tenant requires explicit scope

# ----- LLM keys (at least one required) ----------------------------------------
openai_api_key    = ""                           # sensitive — prefer TF_VAR_openai_api_key
anthropic_api_key = ""                           # sensitive — prefer TF_VAR_anthropic_api_key
gemini_api_key    = ""                           # sensitive — prefer TF_VAR_gemini_api_key

# ----- AWS (required for this example) ------------------------------------------
aws_role_arn = "arn:aws:iam::000000000000:role/stackgen-aios-readonly"
aws_region   = "us-east-1"

# ----- GitHub (required) --------------------------------------------------------
github_token = "ghp_replace_me"                  # sensitive — prefer TF_VAR_github_token

# ----- Slack (required for this example) ----------------------------------------
slack_bot_token      = "xoxb_replace_me"         # sensitive — prefer TF_VAR_slack_bot_token
slack_signing_secret = ""                        # optional
slack_webhook_url    = ""                        # optional

# ----- Grafana (optional — enables alert-triage wiring) -------------------------
grafana_server = ""                              # e.g. https://grafana.example.com
grafana_token  = ""                              # sensitive — prefer TF_VAR_grafana_token

# ----- Langfuse (optional observability) ----------------------------------------
langfuse_public_key = ""
langfuse_secret_key = ""                         # sensitive
langfuse_host       = "https://cloud.langfuse.com"

# ----- Software-engineering agent MCP names (optional) --------------------------
# Pre-provision Guild integrations for Linear MCP and Cursor MCP before enabling
# the software_engineering module. Leave defaults if those integrations exist.
linear_mcp_integration_name = "linear-mcp"
cursor_mcp_integration_name = "cursor-mcp"
