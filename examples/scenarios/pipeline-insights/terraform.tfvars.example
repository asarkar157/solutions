# =============================================================================
# Scenario: pipeline-insights — example tfvars
# =============================================================================
#   make demo SCENARIO=pipeline-insights
# or:
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars && tofu init && tofu apply

stackgen_url        = "https://main.dev.stackgen.com"
stackgen_token      = "sg_pat_replace_me"     # sensitive
stackgen_project_id = ""

openai_api_key    = ""                         # at least one of these is required
anthropic_api_key = ""
gemini_api_key    = ""

# Required: GitHub PAT (repo + read:org)
github_token = "ghp_replace_me"               # sensitive — prefer TF_VAR_github_token

# Optional: Slack — when set, both agents post via the Slack integration
slack_bot_token = ""                           # sensitive

# Optional: prefill service → repo mapping so the release-tracker can resolve
# service names to repos without the operator naming the repo each time.
service_catalog = {
  # payments      = "appcd-dev/payments"
  # checkout-api  = "appcd-dev/checkout"
}

image_namespace_template = "ghcr.io/appcd-dev/{{service}}"
