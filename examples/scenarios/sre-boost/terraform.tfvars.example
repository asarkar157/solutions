# Scenario: sre-boost — example tfvars

stackgen_url        = "https://main.dev.stackgen.com"
stackgen_token      = "sg_pat_replace_me"
stackgen_project_id = ""

agent_name = "aws-sre"

# Customer role already on StackGen bastion allowlist (not the bastion ARN from aws config).
