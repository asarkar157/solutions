# =============================================================================
# Scenario: finops-weekly — example tfvars
# =============================================================================
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars
#   tofu init && tofu apply
#
# Or, from the repo root:   make demo SCENARIO=finops-weekly

stackgen_url        = "https://main.dev.stackgen.com"
stackgen_token      = "sg_pat_replace_me"     # sensitive — prefer TF_VAR_stackgen_token
stackgen_project_id = ""

# At least one of these:
openai_api_key    = ""                         # sensitive — prefer TF_VAR_openai_api_key
anthropic_api_key = ""                         # sensitive — prefer TF_VAR_anthropic_api_key
gemini_api_key    = ""                         # sensitive — prefer TF_VAR_gemini_api_key

# Required: AWS connection
aws_role_arn = "arn:aws:iam::000000000000:role/stackgen-aios-readonly"
aws_region   = "us-east-1"

# Required: Slack (the whole point of this scenario is the weekly Slack summary)
slack_bot_token = ""                           # sensitive — prefer TF_VAR_slack_bot_token

# Optional: tune the janitor's idle threshold
inactivity_days = 30
